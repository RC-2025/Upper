	$(MAKE) $(MAKESILENT) -f CMakeFiles/xbox_node.dir/build.make CMakeFiles/xbox_node.dir/src/model_xbox.cpp.i
.PHONY : src/model_xbox.cpp.i

src/model_xbox.s: src/model_xbox.cpp.s
.PHONY : src/model_xbox.s

# target to generate assembly for a file
src/model_xbox.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/xbox_node.dir/build.make CMakeFiles/xbox_node.dir/src/model_xbox.cpp.s
.PHONY : src/model_xbox.cpp.s

